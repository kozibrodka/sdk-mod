{
  "schemaVersion": 1,
  "id": "sdk",
  "version": "${version}",

  "name": "SDK Mod",
  "description": "Oryginally created by ScottyDoesKnow in 2010. A mod which guns to your game, it also provides grenades and utilities, as well as driveable atv car.",
  "authors": [
    "kozibrodka"
  ],
  "contact": {
    "homepage": "https://glass-launcher.net/",
    "sources": "https://github.com/calmilamsy/BIN-fabric-example-mod"
  },
  "license": "CC0-4.0",
  "icon": "assets/sdk/iconSDK.png",
  "environment": "*",
  "accessWidener": "sdkmod.accesswidener",
  "entrypoints": {
    "stationapi:event_bus": [
      "net.kozibrodka.sdk.events.ItemListener",
      "net.kozibrodka.sdk.events.EntityListener",
      "net.kozibrodka.sdk.events.BlockListener",
      "net.kozibrodka.sdk.events.TileEntityListener",
      "net.kozibrodka.sdk.events.RecipeListener"
    ],
    "stationapi:event_bus_client": [
      "net.kozibrodka.sdk.events.TextureListener",
      "net.kozibrodka.sdk.events.RenderListener"
    ],
    "stationapi:event_bus_server": [

    ]
  },
  "mixins": [
    "sdk.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
